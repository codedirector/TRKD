# =============================================================================
# Trackd — Environment Configuration Template
# Copy this file to .env and configure values as needed.
# All external integrations are optional: Trackd runs out-of-the-box with
# resilient local storage, sandbox checkout, and fallback commit heuristics.
# =============================================================================

# SERVER & APPLICATION HOSTING
PORT=3000
APP_URL="http://localhost:3000"

# GEMINI AI (Optional)
# Used for intelligent Git-style conventional commit messages and version diff analysis.
# If omitted, intelligent rule-based conventional commit heuristics are used automatically.
GEMINI_API_KEY=

# MONGODB DATABASE (Optional)
# When provided, all documents, users, versions, and analytics are synced to MongoDB Atlas.
# If omitted or offline, Trackd automatically falls back to local JSON storage (data/db.json).
MONGODB_URI=
MONGODB_DB_NAME="trackd"

# CLOUDINARY MEDIA STORAGE (Optional)
# Used for cloud storage of uploaded PDF documents and avatar images.
# If omitted or unconfigured, Trackd automatically saves files to local disk (/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# RAZORPAY BILLING & PAYMENTS (Optional)
# Used for live subscription billing and server-side HMAC SHA256 payment verification.
# If omitted, the built-in Sandbox Simulator enables full checkout and testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CLERK AUTHENTICATION (Optional)
# Connects Clerk as an authoritative identity provider with Google OAuth and session management.
# If omitted, Trackd's built-in standalone authentication (bcrypt + JWT) is used automatically.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
